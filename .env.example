# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8787

# ---- 数据 ----
# SQLite 落库文件路径（相对仓库根目录）
DB_PATH=./data/funds.db

# 进程时区：影响净值日期换算与定时任务触发时刻，务必保持 Asia/Shanghai
TZ=Asia/Shanghai

# ---- 定时任务 ----
# 本地开发保持 false；服务器常驻时设为 true
JOBS_ENABLED=false

# ---- 日志 ----
LOG_LEVEL=info

# ---- 静态资源 ----
# 由本服务托管前端构建产物（生产用）。开发时保持 false ——
# 否则 :8787 会托管上一次 pnpm build 的旧前端，容易误以为改动没生效。
SERVE_STATIC=true
# 前端构建产物目录，默认 apps/web/dist
# WEB_DIST_PATH=

# ---- ETF 工具 ----
# 行情渠道的**默认值**（默认 true = 优先东方财富）。
# 界面上可以随时切换（存 app_setting 表），运行时配置优先于这个变量；
# 东财走 ulist.np 批量报价（代码池来自目录接口 B），只有它提供折溢价率/上市日期/量比，
# 失败会自动降级回新浪。设 false = 不切换时默认只走新浪。
ETF_EASTMONEY_ENABLED=true

# ---- 上游请求约束（对非官方接口保持克制，不建议上调）----
UPSTREAM_TIMEOUT_MS=60000
UPSTREAM_CONCURRENCY=2
UPSTREAM_MIN_INTERVAL_MS=300

# ---- news 工具：信息流与 AI 每日简报 ----
# 部分英文信源（FT / Nikkei / SCMP / Economist / Google News…）在某些网络下需要代理才能直连：
# Node 的 fetch **默认不读** HTTP(S)_PROXY 环境变量（curl 会读），症状是 `fetch failed / ETIMEDOUT`、
# 信源页上 last_status 为空、last_error 为超时。要让它像 curl 一样走代理，启动时带上：
#   NODE_USE_ENV_PROXY=1 pnpm dev        # 或 pnpm start / pnpm smoke
# 已直连可达的信源（CNBC/ECB/BoE/Fed/SEC）不带代理也正常 —— 不需要代理时不要开这个开关。
#
# 条目保留期（天）：由 news.fetch 任务顺带清理，防条目表无限膨胀
NEWS_ITEM_RETENTION_DAYS=180

# AI 配置的**默认值**：环境变量只是「没有运行时配置时」的兜底，
# 在界面上填过的值存在 app_setting 表里，优先级高于这里，改完不重启。
# 两个都留空 = 还没配置：生成简报会明确报 400，而不是拿空地址去打网络。
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# 温度（总结要稳，不要创造性）
AI_TEMPERATURE=0.3
# 单次输出上限
AI_MAX_TOKENS=4000
# 输入预算上限（实际目标取 0.6，留 40% 给输出与估算误差）
AI_MAX_INPUT_TOKENS=60000
# 每天最多几次 AI 调用（含「测试连接」）—— 硬护栏
AI_DAILY_LIMIT=10

# ---- 缓存与新鲜度 ----
# 进程内缓存 TTL（秒）
MEMORY_CACHE_TTL_SEC=1800
# 超过此窗口的快照视为需要向上游刷新（秒）
STALE_WINDOW_SEC=21600
