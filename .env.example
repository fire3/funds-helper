# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8787

# ---- 数据 ----
# SQLite 落库文件路径（相对仓库根目录）
DB_PATH=./data/funds.db

# 进程时区：影响净值日期换算与定时任务触发时刻，务必保持 Asia/Shanghai
TZ=Asia/Shanghai

# ---- 定时任务 ----
# 本地开发保持 false；服务器常驻时设为 true
JOBS_ENABLED=false

# ---- 日志 ----
LOG_LEVEL=info

# ---- 静态资源 ----
# 由本服务托管前端构建产物（生产用）。开发时保持 false ——
# 否则 :8787 会托管上一次 pnpm build 的旧前端，容易误以为改动没生效。
SERVE_STATIC=true
# 前端构建产物目录，默认 apps/web/dist
# WEB_DIST_PATH=

# ---- 上游请求约束（对非官方接口保持克制，不建议上调）----
UPSTREAM_TIMEOUT_MS=60000
UPSTREAM_CONCURRENCY=2
UPSTREAM_MIN_INTERVAL_MS=300

# ---- 缓存与新鲜度 ----
# 进程内缓存 TTL（秒）
MEMORY_CACHE_TTL_SEC=1800
# 超过此窗口的快照视为需要向上游刷新（秒）
STALE_WINDOW_SEC=21600
